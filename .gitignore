# ============================================================
# ЧТО НЕ ПОПАДАЁТ В РЕПОЗИТОРИЙ
# ------------------------------------------------------------
# Репозиторий для GitHub Pages должен быть публичным, то есть
# всё в нём видно любому человеку в интернете. Поэтому здесь
# перечислено то, что наружу выходить не должно.
# ============================================================

# ГЛАВНОЕ: токен бота — это пароль от него. Раньше он лежал
# строкой в bot/bot.py, и поэтому пряталась вся папка bot.
# Из-за этого код бота не попадал на хостинг и запускать там
# было нечего. Теперь токен вынесен в отдельный файл: прячем
# только его, а сам код бота спокойно едет в репозиторий.
bot/token.txt

# Заказы и фото покупателей — это персональные данные.
# В публичный репозиторий им нельзя.
bot/orders/
bot/inbox/
bot/state.json

# Служебные файлы редактора и системы
.claude/
__pycache__/
*.pyc
Thumbs.db
desktop.ini
.DS_Store

# Заметки для себя, если появятся
NOTES.txt
*.local
